# Backend URL for the built app (dev uses the /api proxy by default)
# VITE_API_BASE_URL=https://your-tollwise-api.example.com

# Where `npm run dev` forwards /api requests
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Start with labelled sample data instead of calling the API
# VITE_USE_SAMPLE_DATA=true
